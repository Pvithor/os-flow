{
  "name": "os-flow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --no-warnings --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "build:cf": "vite build && wrangler deploy --dry-run",
    "deploy:cf": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "start": "node --no-warnings server/index.mjs",
    "test:api": "node --no-warnings server/test-api.mjs",
    "test:worker": "node --no-warnings worker/test-worker.mjs"
  },
  "dependencies": {
    "@sentry/react": "^11.16.0",
    "@supabase/supabase-js": "^2.119.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "hono": "^4.13.20",
    "lucide-react": "^1.0.0",
    "posthog-js": "^1.453.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261122.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "wrangler": "^4.166.0"
  }
}
